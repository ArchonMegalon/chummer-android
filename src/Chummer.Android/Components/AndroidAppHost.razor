@inject IAndroidSystemService SystemService
@inject IAndroidAccountLinkService AccountLink
@inject IAndroidDocumentService DocumentService
@inject AndroidDocumentInbox DocumentInbox
@inject AndroidAppState State
@inject AndroidJsBridge NativeBridge
@inject IJSRuntime JsRuntime
@using Chummer.Blazor.Components.Layout
@implements IAsyncDisposable

<div class="android-app-shell"
     data-platform="android"
     data-active-destination="@State.ActiveDestination"
     aria-busy="@State.IsBusy.ToString().ToLowerInvariant()">
    <a class="android-skip-link" href="#android-main">Skip to content</a>

    <header class="android-topbar">
        <div class="android-brand">
            <span class="android-eyebrow">CHUMMER</span>
            <strong>@Title</strong>
        </div>
        <button type="button"
                class="account-pill"
                data-state="@AccountState"
                disabled="@State.IsBusy"
                @onclick="() => Navigate(AndroidDestination.Account)"
                aria-label="Open account linking">
            <span class="account-dot" aria-hidden="true"></span>
            <span>@AccountLink.Snapshot.Label</span>
        </button>
    </header>

    @if (State.IsBusy)
    {
        <div class="android-progress" role="progressbar" aria-label="Working"><span></span></div>
    }

    <main id="android-main" class="android-content" tabindex="-1">
        @if (!string.IsNullOrWhiteSpace(State.LastMessage))
        {
            <div class="android-notice" data-kind="@NoticeKind" role="status" aria-live="polite">
                <span>@State.LastMessage</span>
                <button type="button" @onclick="State.ClearMessage" aria-label="Dismiss message">×</button>
            </div>
        }

        @switch (State.ActiveDestination)
        {
            case AndroidDestination.Home:
                <section class="android-screen android-home" aria-labelledby="android-home-title">
                    <header class="android-screen-header">
                        <p class="android-kicker">Runner desk</p>
                        <h1 id="android-home-title">Ready when you are.</h1>
                        <div class="android-status-row" aria-label="App status">
                            <span>Local-first</span>
                            <span>SR4 · SR5 · SR6</span>
                        </div>
                    </header>

                    <div class="android-action-grid android-home-actions">
                        <AndroidActionCard Icon="build"
                                           Title="New runner"
                                           Description="Start a build"
                                           Primary="true"
                                           Disabled="@State.IsBusy"
                                           OnClick="StartNewRunner" />
                        <AndroidActionCard Icon="folder"
                                           Title="Open character"
                                           Description="Choose from Documents"
                                           Disabled="@State.IsBusy"
                                           OnClick="OpenDocumentAsync" />
                        <AndroidActionCard Icon="workbench"
                                           Title="Workbench"
                                           Description="Resume or inspect"
                                           Disabled="@State.IsBusy"
                                           OnClick="OpenWorkbench" />
                        <AndroidActionCard Icon="play"
                                           Title="Live play"
                                           Description="Join a table"
                                           External="true"
                                           Disabled="@State.IsBusy"
                                           OnClick="OpenPlayAsync" />
                    </div>
                </section>
                break;
            case AndroidDestination.Workbench:
                <section class="android-workbench" aria-label="Full Chummer workbench">
                    <DesktopShell @ref="_desktopShell" />
                </section>
                break;
            case AndroidDestination.Campaign:
                <section class="android-screen android-campaign" aria-labelledby="android-campaign-title">
                    <header class="android-screen-header">
                        <p class="android-kicker">Connected tools</p>
                        <h1 id="android-campaign-title">Campaign command.</h1>
                        <span class="android-inline-note"><AndroidIcon Name="privacy" /> Sign-in may be required</span>
                    </header>

                    <div class="android-action-grid">
                        <AndroidActionCard Icon="campaign"
                                           Title="Campaign workspace"
                                           Description="Roster and prep"
                                           External="true"
                                           Disabled="@State.IsBusy"
                                           OnClick="OpenCampaignWorkspaceAsync" />
                        <AndroidActionCard Icon="play"
                                           Title="GM command"
                                           Description="Runboard and session"
                                           External="true"
                                           Disabled="@State.IsBusy"
                                           OnClick="OpenGmCommandAsync" />
                        <AndroidActionCard Icon="account"
                                           Title="Organizer desk"
                                           Description="Roles and publishing"
                                           External="true"
                                           Disabled="@State.IsBusy"
                                           OnClick="OpenOrganizerCommandAsync" />
                        <AndroidActionCard Icon="workbench"
                                           Title="Ruleset studio"
                                           Description="Campaign rules"
                                           External="true"
                                           Disabled="@State.IsBusy"
                                           OnClick="OpenRulesetStudioAsync" />
                        <AndroidActionCard Icon="play"
                                           Title="Join live play"
                                           External="true"
                                           Disabled="@State.IsBusy"
                                           OnClick="OpenPlayAsync" />
                    </div>
                </section>
                break;
            case AndroidDestination.Account:
                <section class="android-screen android-account" aria-labelledby="android-account-title">
                    <header class="android-screen-header">
                        <p class="android-kicker">Chummer account</p>
                        <h1 id="android-account-title">@AccountHeading</h1>
                    </header>

                    <section class="account-card" data-state="@AccountState" aria-label="Account link status">
                        <div class="account-card-status">
                            <span class="account-mark"><AndroidIcon Name="account" /></span>
                            <span><small>Device access</small><strong>@AccountLink.Snapshot.Label</strong></span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(AccountLink.Snapshot.Detail))
                        {
                            <p>@AccountLink.Snapshot.Detail</p>
                        }
                        <div class="account-actions">
                            @if (AccountLink.Snapshot.IsLinked)
                            {
                                <button type="button" class="android-primary-button" disabled="@State.IsBusy" @onclick="OpenLinkedAccountAsync">Manage installs</button>
                                @if (_confirmUnlink)
                                {
                                    <button type="button" class="android-danger-button" disabled="@State.IsBusy" @onclick="UnlinkAccountAsync">Confirm unlink</button>
                                    <button type="button" class="android-text-button" disabled="@State.IsBusy" @onclick="CancelUnlink">Cancel</button>
                                }
                                else
                                {
                                    <button type="button" class="android-text-button" disabled="@State.IsBusy" @onclick="ConfirmUnlink">Unlink this device</button>
                                }
                            }
                            else if (AccountLink.Snapshot.IsPending)
                            {
                                <button type="button" class="android-primary-button" disabled="@State.IsBusy" @onclick="CheckAccountLinkAsync">Check link</button>
                                <button type="button" class="android-text-button" disabled="@State.IsBusy" @onclick="BeginAccountLinkAsync">Start again</button>
                            }
                            else
                            {
                                <button type="button" class="android-primary-button" disabled="@State.IsBusy" @onclick="BeginAccountLinkAsync">Link account</button>
                            }
                        </div>
                    </section>

                    <div class="android-action-grid android-secondary-actions">
                        <AndroidActionCard Icon="support" Title="Support" External="true" Disabled="@State.IsBusy" OnClick="OpenSupportAsync" />
                        <AndroidActionCard Icon="privacy" Title="Privacy" External="true" Disabled="@State.IsBusy" OnClick="OpenPrivacyAsync" />
                    </div>
                </section>
                break;
            case AndroidDestination.More:
                <section class="android-screen android-more" aria-labelledby="android-more-title">
                    <header class="android-screen-header">
                        <p class="android-kicker">Tools</p>
                        <h1 id="android-more-title">Files and output.</h1>
                    </header>

                    <section class="android-tool-section" aria-labelledby="files-output-heading">
                        <h2 id="files-output-heading">On this device</h2>
                        <div class="android-action-grid">
                            <AndroidActionCard Icon="folder" Title="Import file" Description="Android Documents" Disabled="@State.IsBusy" OnClick="OpenDocumentAsync" />
                            <AndroidActionCard Icon="workbench" Title="Print or export" Description="Open workbench" Disabled="@State.IsBusy" OnClick="OpenWorkbenchForOutput" />
                        </div>
                    </section>

                    <section class="android-tool-section" aria-labelledby="app-heading">
                        <h2 id="app-heading">Chummer</h2>
                        <div class="android-action-grid">
                            <AndroidActionCard Icon="share" Title="Share app" Disabled="@State.IsBusy" OnClick="ShareAppAsync" />
                            <AndroidActionCard Icon="update" Title="Check for updates" External="true" Disabled="@State.IsBusy" OnClick="OpenUpdateAsync" />
                        </div>
                    </section>
                </section>
                break;
        }
    </main>

    <nav class="android-bottom-nav" aria-label="Primary navigation">
        <button class="@ActiveClass(AndroidDestination.Home)"
                disabled="@State.IsBusy"
                aria-current="@AriaCurrent(AndroidDestination.Home)"
                @onclick="() => Navigate(AndroidDestination.Home)">
            <AndroidIcon Name="home" /><span>Home</span>
        </button>
        <button class="@ActiveClass(AndroidDestination.Workbench)"
                disabled="@State.IsBusy"
                aria-current="@AriaCurrent(AndroidDestination.Workbench)"
                @onclick="OpenWorkbench">
            <AndroidIcon Name="build" /><span>Build</span>
        </button>
        <button class="@ActiveClass(AndroidDestination.Campaign)"
                disabled="@State.IsBusy"
                aria-current="@AriaCurrent(AndroidDestination.Campaign)"
                @onclick="OpenCampaign">
            <AndroidIcon Name="campaign" /><span>Campaign</span>
        </button>
        <button class="@ActiveClass(AndroidDestination.Account)"
                disabled="@State.IsBusy"
                aria-current="@AriaCurrent(AndroidDestination.Account)"
                @onclick="() => Navigate(AndroidDestination.Account)">
            <AndroidIcon Name="account" /><span>Account</span>
        </button>
        <button class="@ActiveClass(AndroidDestination.More)"
                disabled="@State.IsBusy"
                aria-current="@AriaCurrent(AndroidDestination.More)"
                @onclick="() => Navigate(AndroidDestination.More)">
            <AndroidIcon Name="more" /><span>More</span>
        </button>
    </nav>
</div>

@code {
    private const string NewCharacterCommandId = "new_character";
    private DotNetObjectReference<AndroidJsBridge>? _nativeBridgeReference;
    private DesktopShell? _desktopShell;
    private string? _pendingWorkbenchCommand;
    private bool _confirmUnlink;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnAppStateChanged;
        AccountLink.Changed += OnAccountLinkChanged;
        await AccountLink.InitializeAsync();
    }

    private string Title => State.ActiveDestination switch
    {
        AndroidDestination.Workbench => "Workbench",
        AndroidDestination.Campaign => "Campaign",
        AndroidDestination.Account => "Account",
        AndroidDestination.More => "More",
        _ => "Runner home"
    };

    private string AccountHeading => AccountLink.Snapshot.Status switch
    {
        AndroidAccountLinkStatus.Linked => "Your device is linked.",
        AndroidAccountLinkStatus.Pending => "Finish the handoff.",
        AndroidAccountLinkStatus.Error => "Link needs attention.",
        AndroidAccountLinkStatus.Loading => "Checking your link.",
        _ => "Link this device."
    };

    private string AccountState => AccountLink.Snapshot.Status.ToString().ToLowerInvariant();
    private string NoticeKind => State.NoticeKind.ToString().ToLowerInvariant();

    private void Navigate(AndroidDestination destination, bool clearMessage = true)
    {
        if (clearMessage)
        {
            State.ClearMessage();
        }

        _confirmUnlink = false;
        State.ActiveDestination = destination;
    }

    private void StartNewRunner()
    {
        if (State.IsBusy)
        {
            return;
        }

        State.IsBusy = true;
        _pendingWorkbenchCommand = NewCharacterCommandId;
        Navigate(AndroidDestination.Workbench);
    }

    private void OpenWorkbench() => Navigate(AndroidDestination.Workbench);
    private void OpenCampaign() => Navigate(AndroidDestination.Campaign);

    private void OpenWorkbenchForOutput()
    {
        Navigate(AndroidDestination.Workbench);
        State.SetMessage("Use File › Print or File › Export.");
    }

    private string ActiveClass(AndroidDestination destination)
        => State.ActiveDestination == destination ? "active" : string.Empty;

    private string? AriaCurrent(AndroidDestination destination)
        => State.ActiveDestination == destination ? "page" : null;

    private async Task OpenDocumentAsync()
    {
        if (State.IsBusy)
        {
            return;
        }

        State.ClearMessage();
        State.IsBusy = true;
        try
        {
            AndroidDocument? document = await DocumentService.OpenAsync(CancellationToken.None);
            if (document is null)
            {
                State.SetMessage("No file selected.");
                return;
            }

            DocumentInbox.Add(document);
            Navigate(AndroidDestination.Workbench, clearMessage: false);
            State.SetMessage($"Opening {document.DisplayName}.", AndroidNoticeKind.Success);
        }
        catch (Exception)
        {
            State.SetMessage("That file could not be opened.", AndroidNoticeKind.Error);
        }
        finally
        {
            State.IsBusy = false;
        }
    }

    private Task OpenPlayAsync() => OpenWebAsync(ChummerWebRoutes.Play, "live play");
    private Task OpenSupportAsync() => OpenWebAsync(ChummerWebRoutes.Support, "support");
    private Task OpenPrivacyAsync() => OpenWebAsync(ChummerWebRoutes.AccountDeletion, "privacy");
    private Task OpenCampaignWorkspaceAsync() => OpenWebAsync(ChummerWebRoutes.CampaignRoster, "campaign workspace");
    private Task OpenGmCommandAsync() => OpenWebAsync(ChummerWebRoutes.GmCommand, "GM command");
    private Task OpenOrganizerCommandAsync() => OpenWebAsync(ChummerWebRoutes.OrganizerCommand, "organizer desk");
    private Task OpenRulesetStudioAsync() => OpenWebAsync(ChummerWebRoutes.RulesetStudio, "ruleset studio");

    private async Task BeginAccountLinkAsync()
        => await RunAccountActionAsync(() => AccountLink.BeginLinkAsync());

    private async Task CheckAccountLinkAsync()
        => await RunAccountActionAsync(() => AccountLink.ResumePendingLinkAsync());

    private async Task OpenLinkedAccountAsync()
        => await RunAccountActionAsync(() => AccountLink.OpenAccountAsync());

    private void ConfirmUnlink() => _confirmUnlink = true;
    private void CancelUnlink() => _confirmUnlink = false;

    private async Task UnlinkAccountAsync()
    {
        _confirmUnlink = false;
        await RunAccountActionAsync(() => AccountLink.UnlinkAsync());
        if (AccountLink.Snapshot.Status == AndroidAccountLinkStatus.Unlinked)
        {
            State.SetMessage("Device unlinked.", AndroidNoticeKind.Success);
        }
    }

    private async Task RunAccountActionAsync(Func<Task> action)
    {
        if (State.IsBusy)
        {
            return;
        }

        State.ClearMessage();
        State.IsBusy = true;
        try
        {
            await action();
        }
        catch (Exception)
        {
            State.SetMessage("Account access is unavailable.", AndroidNoticeKind.Error);
        }
        finally
        {
            State.IsBusy = false;
        }
    }

    private async Task OpenWebAsync(string path, string label)
    {
        if (State.IsBusy)
        {
            return;
        }

        State.ClearMessage();
        State.IsBusy = true;
        try
        {
            if (!await SystemService.OpenUriAsync(ChummerWebRoutes.Resolve(path)))
            {
                State.SetMessage($"Could not open {label}.", AndroidNoticeKind.Error);
            }
        }
        catch (Exception)
        {
            State.SetMessage($"Could not open {label}.", AndroidNoticeKind.Error);
        }
        finally
        {
            State.IsBusy = false;
        }
    }

    private async Task OpenUpdateAsync()
    {
        if (State.IsBusy)
        {
            return;
        }

        State.IsBusy = true;
        try
        {
            if (!await SystemService.OpenStoreListingAsync())
            {
                State.SetMessage("Could not open Google Play.", AndroidNoticeKind.Error);
            }
        }
        catch (Exception)
        {
            State.SetMessage("Could not open Google Play.", AndroidNoticeKind.Error);
        }
        finally
        {
            State.IsBusy = false;
        }
    }

    private async Task ShareAppAsync()
    {
        if (State.IsBusy)
        {
            return;
        }

        State.IsBusy = true;
        try
        {
            await SystemService.ShareTextAsync("Chummer — build runners and run campaigns anywhere. https://chummer.run");
        }
        catch (Exception)
        {
            State.SetMessage("Could not open the share sheet.", AndroidNoticeKind.Error);
        }
        finally
        {
            State.IsBusy = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _nativeBridgeReference = DotNetObjectReference.Create(NativeBridge);
            await JsRuntime.InvokeVoidAsync("chummerAndroid.initialize", _nativeBridgeReference);
        }

        if (_pendingWorkbenchCommand is null || _desktopShell is null)
        {
            return;
        }

        string commandId = _pendingWorkbenchCommand;
        _pendingWorkbenchCommand = null;
        try
        {
            await _desktopShell.ExecuteCommandFromSurfaceAsync(commandId);
        }
        catch (Exception)
        {
            State.SetMessage("The new runner workflow could not be opened.", AndroidNoticeKind.Error);
        }
        finally
        {
            State.IsBusy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnAppStateChanged;
        AccountLink.Changed -= OnAccountLinkChanged;
        try
        {
            await JsRuntime.InvokeVoidAsync("chummerAndroid.dispose");
        }
        catch (JSDisconnectedException)
        {
        }
        finally
        {
            _nativeBridgeReference?.Dispose();
        }
    }

    private void OnAppStateChanged(object? sender, EventArgs e)
        => _ = InvokeAsync(StateHasChanged);

    private void OnAccountLinkChanged(object? sender, EventArgs e)
        => _ = InvokeAsync(StateHasChanged);
}
