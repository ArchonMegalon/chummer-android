<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ChummerPresentationRoot Condition="'$(ChummerPresentationRoot)' == ''">../../../chummer-presentation</ChummerPresentationRoot>
    <ChummerCoreEngineRoot Condition="'$(ChummerCoreEngineRoot)' == ''">$(ChummerPresentationRoot)/../chummer-core-engine</ChummerCoreEngineRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="AuthorityCompileStubs.cs" />
    <Compile Include="../../src/Chummer.Android/Native/Sr5PlaytimeDamageTransaction.cs"
             Link="Native/Sr5PlaytimeDamageTransaction.cs" />
    <Compile Include="../../src/Chummer.Android/Native/Sr5CareerMutationOwnerStore.cs"
             Link="Native/Sr5CareerMutationOwnerStore.cs" />
    <Compile Include="$(ChummerPresentationRoot)/Chummer.Presentation/Overview/ConditionMonitorEditRequest.cs"
             Link="Presentation/ConditionMonitorEditRequest.cs" />
    <Compile Include="$(ChummerPresentationRoot)/Chummer.Presentation/Overview/ConditionMonitorEditorState.cs"
             Link="Presentation/ConditionMonitorEditorState.cs" />
    <ProjectReference Include="$(ChummerCoreEngineRoot)/Chummer.Contracts/Chummer.Contracts.csproj" />
  </ItemGroup>
</Project>
