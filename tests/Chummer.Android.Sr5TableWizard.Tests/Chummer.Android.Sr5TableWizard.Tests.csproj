<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ChummerPresentationRoot Condition="'$(ChummerPresentationRoot)' == ''">../../../presentation</ChummerPresentationRoot>
    <ChummerCoreEngineRoot Condition="'$(ChummerCoreEngineRoot)' == ''">../../../core</ChummerCoreEngineRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../src/Chummer.Android/Native/Sr5TableWizardPhoneModel.cs"
             Link="Native/Sr5TableWizardPhoneModel.cs" />
    <Compile Include="../../src/Chummer.Android/Native/Sr5CareerFlowStrings.cs"
             Link="Native/Sr5CareerFlowStrings.cs" />
    <Compile Include="../../src/Chummer.Android/Native/Sr5CareerRunCapabilityCatalog.cs"
             Link="Native/Sr5CareerRunCapabilityCatalog.cs" />
    <Compile Include="../../src/Chummer.Android/Native/Sr5TableWizardTypedTransaction.cs"
             Link="Native/Sr5TableWizardTypedTransaction.cs" />
    <Compile Include="$(ChummerPresentationRoot)/Chummer.Presentation/Overview/CareerEdgeUseEditRequest.cs"
             Link="Presentation/CareerEdgeUseEditRequest.cs" />
    <Compile Include="$(ChummerPresentationRoot)/Chummer.Presentation/Overview/CareerWeaponFireRequest.cs"
             Link="Presentation/CareerWeaponFireRequest.cs" />
    <Compile Include="$(ChummerPresentationRoot)/Chummer.Presentation/Overview/Sr5TableWizardSession.cs"
             Link="Presentation/Sr5TableWizardSession.cs" />
    <ProjectReference Include="$(ChummerCoreEngineRoot)/Chummer.Contracts/Chummer.Contracts.csproj" />
  </ItemGroup>
</Project>
