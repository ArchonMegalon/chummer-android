<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);AUTHORITY_LIGHTWEIGHT</DefineConstants>
    <ChummerCoreRoot Condition="'$(ChummerCoreRoot)' == ''">../../../chummer-core-engine</ChummerCoreRoot>
    <ChummerPresentationRoot Condition="'$(ChummerPresentationRoot)' == ''">../../../chummer-presentation</ChummerPresentationRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(ChummerCoreRoot)/Chummer.Contracts/Chummer.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Chummer.Android.Sr5CareerWizard.Tests/Program.cs" Link="Program.cs" />
    <Compile Include="AuthorityCompileStubs.cs" />
    <Compile Include="../../src/Chummer.Android/Native/Sr5CareerActiveSkillCoordinator.cs" Link="Native/Sr5CareerActiveSkillCoordinator.cs" />
    <Compile Include="../../src/Chummer.Android/Native/Sr5CareerActiveSkillWizardPage.cs" Link="Native/Sr5CareerActiveSkillWizardPage.cs" />
    <Compile Include="../../src/Chummer.Android/Native/Sr5CareerDraftCheckpointStore.cs" Link="Native/Sr5CareerDraftCheckpointStore.cs" />
    <Compile Include="../../src/Chummer.Android/Native/Sr5CareerMutationOwnerStore.cs" Link="Native/Sr5CareerMutationOwnerStore.cs" />
    <Compile Include="../../src/Chummer.Android/Native/Sr5CareerWizardModel.cs" Link="Native/Sr5CareerWizardModel.cs" />
    <Compile Include="$(ChummerPresentationRoot)/Chummer.Presentation/Overview/CareerKarmaExpenseEditRequest.cs" Link="Presentation/CareerKarmaExpenseEditRequest.cs" />
  </ItemGroup>
</Project>
