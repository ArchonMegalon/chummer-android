    <Compile Include="../../src/Chummer.Android/Platform/IAndroidAccountLinkService.cs"
             Link="IAndroidAccountLinkService.cs" />
    <Compile Include="../../src/Chummer.Android/Platform/IAndroidSystemService.cs"
             Link="IAndroidSystemService.cs" />
    <Compile Include="../../src/Chummer.Android/Platform/ChummerWebRoutes.cs"
             Link="ChummerWebRoutes.cs" />
    <Compile Include="../../src/Chummer.Android/Platform/AndroidAccountLinkService.cs"
             Link="AndroidAccountLinkService.cs" />
    <Compile Include="../../src/Chummer.Android/Platform/AndroidAccountLinkKeyAuthority.cs"
             Link="AndroidAccountLinkKeyAuthority.cs" />
