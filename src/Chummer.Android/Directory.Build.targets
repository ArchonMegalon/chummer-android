<Project>
  <PropertyGroup>
    <AfterMicrosoftNETSdkTargets>$(AfterMicrosoftNETSdkTargets);$(MSBuildThisFileDirectory)Chummer.Android.AfterMicrosoftNETSdk.targets</AfterMicrosoftNETSdkTargets>
