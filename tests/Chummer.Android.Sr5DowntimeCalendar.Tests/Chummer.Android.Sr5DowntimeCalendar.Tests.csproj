<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ChummerPresentationRoot Condition="'$(ChummerPresentationRoot)' == ''">../../../chummer-presentation</ChummerPresentationRoot>
    <ChummerCoreEngineRoot Condition="'$(ChummerCoreEngineRoot)' == ''">$(ChummerPresentationRoot)/../chummer-core-engine</ChummerCoreEngineRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="AuthorityCompileStubs.cs" />
    <Compile Include="../../src/Chummer.Android/Native/Sr5DowntimeCalendarPhoneModel.cs" Link="Native/Sr5DowntimeCalendarPhoneModel.cs" />
    <Compile Include="../../src/Chummer.Android/Native/Sr5CareerMutationOwnerStore.cs" Link="Native/Sr5CareerMutationOwnerStore.cs" />
    <Compile Include="$(ChummerPresentationRoot)/Chummer.Presentation/Overview/CareerCalendarEditRequest.cs" Link="Presentation/CareerCalendarEditRequest.cs" />
    <Compile Include="$(ChummerPresentationRoot)/Chummer.Presentation/Overview/Sr5CareerWizardDesktopSession.cs" Link="Presentation/Sr5CareerWizardDesktopSession.cs" />
    <Compile Include="$(ChummerPresentationRoot)/Chummer.Presentation/Overview/Sr5DowntimeCalendarDesktopSession.cs" Link="Presentation/Sr5DowntimeCalendarDesktopSession.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(ChummerCoreEngineRoot)/Chummer.Contracts/Chummer.Contracts.csproj" />
  </ItemGroup>
</Project>
