<button type="button"
        class="android-action-card @(Primary ? "primary-card" : null) @(string.IsNullOrWhiteSpace(Description) ? "compact-card" : null)"
        disabled="@Disabled"
        @onclick="OnClick">
    <AndroidIcon Name="@Icon" CssClass="android-action-icon" />
    <span class="android-action-copy">
        <strong>@Title</strong>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <small>@Description</small>
        }
    </span>
    <AndroidIcon Name="@(External ? "external" : "chevron")" CssClass="android-action-affordance" />
</button>

@code {
    [Parameter, EditorRequired]
    public string Icon { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public bool Primary { get; set; }

    [Parameter]
    public bool External { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }
}
