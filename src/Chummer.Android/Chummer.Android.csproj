<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Chummer.Android</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiVersion>10.0.20</MauiVersion>
    <ApplicationTitle>Chummer</ApplicationTitle>
    <ApplicationId>com.myexternalbrain.chummer</ApplicationId>
    <ApplicationDisplayVersion>0.1.0-preview.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <TargetSdkVersion>36</TargetSdkVersion>
    <AndroidMinSdkVersion>24</AndroidMinSdkVersion>
    <AndroidPackageFormats Condition="'$(Configuration)' == 'Debug'">apk</AndroidPackageFormats>
    <AndroidPackageFormats Condition="'$(Configuration)' == 'Release'">aab</AndroidPackageFormats>
    <EmbedAssembliesIntoApk Condition="'$(Configuration)' == 'Debug'">true</EmbedAssembliesIntoApk>
    <AndroidUseAapt2>true</AndroidUseAapt2>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <AndroidLinkMode Condition="'$(Configuration)' == 'Release'">SdkOnly</AndroidLinkMode>
    <AndroidEnableProfiledAot Condition="'$(Configuration)' == 'Release'">true</AndroidEnableProfiledAot>
    <ChummerDesktopRuntimeIdentifiers>android-arm64;android-x64</ChummerDesktopRuntimeIdentifiers>
    <AndroidKeyStore Condition="'$(AndroidSigningKeyStore)' != ''">true</AndroidKeyStore>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AndroidSigningKeyStore)' != ''">
    <AndroidSigningStorePass>$(ChummerAndroidSigningStorePass)</AndroidSigningStorePass>
    <AndroidSigningKeyAlias>$(ChummerAndroidSigningKeyAlias)</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>$(ChummerAndroidSigningKeyPass)</AndroidSigningKeyPass>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appiconfg.svg" Color="#102426" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#102426" BaseSize="512,512" />
    <MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../chummer-presentation/Chummer.Blazor/Chummer.Blazor.Mobile.csproj"
                      AdditionalProperties="RuntimeIdentifier=;RuntimeIdentifiers=" />
    <ProjectReference Include="../../../chummer-presentation/Chummer.Desktop.Runtime/Chummer.Desktop.Runtime.csproj"
                      AdditionalProperties="RuntimeIdentifier=;RuntimeIdentifiers=" />
    <ProjectReference Include="../../../chummer-presentation/Chummer.Presentation/Chummer.Presentation.csproj"
                      AdditionalProperties="RuntimeIdentifier=;RuntimeIdentifiers=" />
  </ItemGroup>
</Project>
