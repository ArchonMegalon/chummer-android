<Project>
  <PropertyGroup Condition="'$(ChummerReleaseLockRoot)' != ''">
    <NuGetLockFilePath>$(ChummerReleaseLockRoot)/$(MSBuildProjectName).packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ChummerReleaseIntermediateRoot)' != ''">
    <BaseIntermediateOutputPath>$(ChummerReleaseIntermediateRoot)/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(ChummerReleaseIntermediateRoot)/$(MSBuildProjectName)/</MSBuildProjectExtensionsPath>
  </PropertyGroup>

  <!-- Keep this an ordinary property: the SDK must prepend its Git SourceRoot
       mappings so portable PDB document paths and SourceLink remain aligned.
       Generated sources and CodeView PDB paths live outside those Git roots. -->
  <PropertyGroup Condition="'$(ChummerReleaseDeterministicRoot)' != ''">
    <PathMap>$([MSBuild]::ValueOrDefault('$(ChummerReleaseDeterministicRoot)', '').Replace(',', ',,').Replace('=', '=='))=/_/release,$(PathMap)</PathMap>
  </PropertyGroup>
</Project>
