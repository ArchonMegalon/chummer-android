<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ChummerCoreRoot Condition="'$(ChummerCoreRoot)' == ''">../../../chummer-core-engine</ChummerCoreRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(ChummerCoreRoot)/Chummer.Contracts/Chummer.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(ChummerCoreRoot)/Chummer.Application/Characters/ICharacterCustomDrugAuthority.cs"
             Link="Core/ICharacterCustomDrugAuthority.cs" />
    <Compile Include="$(ChummerCoreRoot)/Chummer.Application/Characters/ICharacterCreationCustomDrugContributionService.cs"
             Link="Core/ICharacterCreationCustomDrugContributionService.cs" />
    <Compile Include="../../src/Chummer.Android/Native/Sr5CustomDrugWorkspaceStore.cs"
             Link="Native/Sr5CustomDrugWorkspaceStore.cs" />
    <Compile Include="../../src/Chummer.Android/Native/Sr5CustomDrugLabModel.cs"
             Link="Native/Sr5CustomDrugLabModel.cs" />
    <Compile Include="../../src/Chummer.Android/Native/Sr5CustomDrugLabService.cs"
             Link="Native/Sr5CustomDrugLabService.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
