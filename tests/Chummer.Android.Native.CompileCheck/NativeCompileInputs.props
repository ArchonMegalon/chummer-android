<Project>
  <!--
    This is the complete, owned input boundary for the platform-neutral native gate.
    Native pages are included from one non-recursive directory. Every dependency outside that
    directory is named individually; Android framework implementations are replaced only by the
    fail-closed types in CompileStubs.cs.
  -->
  <ItemGroup>
    <Compile Include="../../src/Chummer.Android/Native/*.cs" Link="Native/%(Filename)%(Extension)" />
    <Compile Include="../../src/Chummer.Android/MainShell.cs" Link="MainShell.cs" />
    <Compile Include="../../src/Chummer.Android/PhoneShellRoutes.cs" Link="PhoneShellRoutes.cs" />
    <Compile Include="../../src/Chummer.Android/MauiProgram.cs" Link="MauiProgram.cs" />
    <Compile Include="../../src/Chummer.Android/Platform/IAndroidAccountLinkService.cs" Link="Platform/IAndroidAccountLinkService.cs" />
    <Compile Include="../../src/Chummer.Android/Platform/IAndroidDocumentService.cs" Link="Platform/IAndroidDocumentService.cs" />
    <Compile Include="../../src/Chummer.Android/Platform/IAndroidImageDocumentService.cs" Link="Platform/IAndroidImageDocumentService.cs" />
    <Compile Include="../../src/Chummer.Android/Platform/IAndroidLinkedCharacterFileService.cs" Link="Platform/IAndroidLinkedCharacterFileService.cs" />
    <Compile Include="../../src/Chummer.Android/Platform/IAndroidSystemService.cs" Link="Platform/IAndroidSystemService.cs" />
    <Compile Include="../../src/Chummer.Android/Platform/AndroidAccountLinkHttpTransport.cs" Link="Platform/AndroidAccountLinkHttpTransport.cs" />
    <Compile Include="../../src/Chummer.Android/Platform/AndroidAccountLinkService.cs" Link="Platform/AndroidAccountLinkService.cs" />
    <Compile Include="../../src/Chummer.Android/Platform/ChummerWebRoutes.cs" Link="Platform/ChummerWebRoutes.cs" />
    <Compile Include="CompileStubs.cs" Link="CompileStubs.cs" />
  </ItemGroup>
</Project>
