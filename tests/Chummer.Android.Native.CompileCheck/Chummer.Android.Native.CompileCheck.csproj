<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ChummerPresentationRoot Condition="'$(ChummerPresentationRoot)' == ''">../../../chummer-presentation</ChummerPresentationRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(ChummerPresentationRoot)/Chummer.Presentation/Chummer.Presentation.csproj" />
    <ProjectReference Include="$(ChummerPresentationRoot)/Chummer.Desktop.Runtime/Chummer.Desktop.Runtime.csproj" />
  </ItemGroup>
  <Import Project="NativeCompileInputs.props" />
  <Target Name="VerifyNativeCompileGraph" BeforeTargets="PrepareForBuild">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../../scripts/verify_native_compile_graph.py&quot; --repo-root &quot;$(MSBuildProjectDirectory)/../..&quot; --project &quot;$(MSBuildProjectFullPath)&quot; --require-assets" />
  </Target>
</Project>
