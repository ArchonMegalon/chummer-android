<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Chummer.Android</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ChummerPresentationRoot Condition="'$(ChummerPresentationRoot)' == ''">../../../chummer-presentation</ChummerPresentationRoot>
    <ChummerNativeProofCaptureTests Condition="'$(ChummerNativeProofCaptureTests)' == ''">false</ChummerNativeProofCaptureTests>
    <DefineConstants Condition="'$(ChummerNativeProofCaptureTests)' == 'true'">$(DefineConstants);CHUMMER_API36_PROOF_INSTRUMENTATION</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(ChummerPresentationRoot)/Chummer.Presentation/Chummer.Presentation.csproj" />
    <ProjectReference Include="$(ChummerPresentationRoot)/Chummer.Desktop.Runtime/Chummer.Desktop.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../src/Chummer.Android/Resources/Localization/PhoneStrings.resx"
                      Link="Resources/Localization/PhoneStrings.resx" />
    <EmbeddedResource Include="../../src/Chummer.Android/Resources/Localization/PhoneStrings.de.resx"
                      Link="Resources/Localization/PhoneStrings.de.resx" />
    <EmbeddedResource Include="../../src/Chummer.Android/Resources/Localization/PhoneStrings.es.resx"
                      Link="Resources/Localization/PhoneStrings.es.resx" />
    <EmbeddedResource Include="../../src/Chummer.Android/Resources/Localization/WizardStrings.resx"
                      Link="Resources/Localization/WizardStrings.resx" />
    <EmbeddedResource Include="../../src/Chummer.Android/Resources/Localization/WizardStrings.de.resx"
                      Link="Resources/Localization/WizardStrings.de.resx" />
    <EmbeddedResource Include="../../src/Chummer.Android/Resources/Localization/WizardStrings.es.resx"
                      Link="Resources/Localization/WizardStrings.es.resx" />
    <EmbeddedResource Include="../../src/Chummer.Android/Resources/Localization/CreationFlowStrings.resx"
                      Link="Resources/Localization/CreationFlowStrings.resx" />
    <EmbeddedResource Include="../../src/Chummer.Android/Resources/Localization/CreationFlowStrings.de.resx"
                      Link="Resources/Localization/CreationFlowStrings.de.resx" />
    <EmbeddedResource Include="../../src/Chummer.Android/Resources/Localization/CreationFlowStrings.es.resx"
                      Link="Resources/Localization/CreationFlowStrings.es.resx" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../src/Chummer.Android/Resources/Localization/CreationAllocationStrings.resx" Link="Resources/Localization/CreationAllocationStrings.resx" />
    <EmbeddedResource Include="../../src/Chummer.Android/Resources/Localization/CreationAllocationStrings.de.resx" Link="Resources/Localization/CreationAllocationStrings.de.resx" />
    <EmbeddedResource Include="../../src/Chummer.Android/Resources/Localization/CreationAllocationStrings.es.resx" Link="Resources/Localization/CreationAllocationStrings.es.resx" />
  </ItemGroup>
  <Import Project="NativeCompileInputs.props" />
  <Target Name="VerifyNativeCompileGraph" BeforeTargets="PrepareForBuild">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ChummerNativeProofCaptureTests)', '\A(true|false)\z'))"
           Text="ChummerNativeProofCaptureTests must be exactly true or false." />
    <Error Condition="'$(ChummerNativeProofCaptureTests)' == 'true' and '$(Configuration)' != 'Debug'"
           Text="ChummerNativeProofCaptureTests is supported only in the managed Debug test build; it is not a Release or APK qualification." />
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../../scripts/verify_native_compile_graph.py&quot; --repo-root &quot;$(MSBuildProjectDirectory)/../..&quot; --project &quot;$(MSBuildProjectFullPath)&quot; --require-assets --proof-capture-tests &quot;$(ChummerNativeProofCaptureTests)&quot;" />
  </Target>
</Project>
