<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Chummer.Android</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiVersion>10.0.20</MauiVersion>
    <ApplicationTitle>Chummer</ApplicationTitle>
    <ApplicationId>com.myexternalbrain.chummer</ApplicationId>
    <ApplicationDisplayVersion>0.1.0-preview.8</ApplicationDisplayVersion>
    <ApplicationVersion>8</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <TargetSdkVersion>36</TargetSdkVersion>
    <AndroidMinSdkVersion>24</AndroidMinSdkVersion>
    <AndroidPackageFormats Condition="'$(Configuration)' == 'Debug'">apk</AndroidPackageFormats>
    <AndroidPackageFormats Condition="'$(Configuration)' == 'Release'">aab</AndroidPackageFormats>
    <EmbedAssembliesIntoApk Condition="'$(Configuration)' == 'Debug'">true</EmbedAssembliesIntoApk>
    <AndroidUseAapt2>true</AndroidUseAapt2>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <ChummerAndroidRuntimeIdentifier Condition="'$(ChummerAndroidRuntimeIdentifier)' == ''">android-arm64</ChummerAndroidRuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(ChummerAndroidRuntimeIdentifier)</RuntimeIdentifier>
    <AndroidLinkMode Condition="'$(Configuration)' == 'Release'">SdkOnly</AndroidLinkMode>
    <AndroidEnableProfiledAot Condition="'$(Configuration)' == 'Release'">true</AndroidEnableProfiledAot>
    <AndroidKeyStore Condition="'$(AndroidSigningKeyStore)' != ''">true</AndroidKeyStore>
    <ChummerPresentationRoot Condition="'$(ChummerPresentationRoot)' == ''">../../../chummer-presentation</ChummerPresentationRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AndroidSigningKeyStore)' != ''">
    <AndroidSigningStorePass>$(ChummerAndroidSigningStorePass)</AndroidSigningStorePass>
    <AndroidSigningKeyAlias>$(ChummerAndroidSigningKeyAlias)</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>$(ChummerAndroidSigningKeyPass)</AndroidSigningKeyPass>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appiconfg.svg" Color="#102426" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#102426" BaseSize="512,512" />
    <MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="Xamarin.Google.Android.Play.App.Update" Version="2.1.0.19" />
    <PackageReference Include="Xamarin.AndroidX.Activity.Ktx" Version="1.13.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.8.9.4" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.5.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(ChummerPresentationRoot)/Chummer.Desktop.Runtime/Chummer.Desktop.Runtime.csproj"
                      AdditionalProperties="RuntimeIdentifier=;RuntimeIdentifiers=;SelfContained=false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;RuntimeIdentifiers;SelfContained" />
    <ProjectReference Include="$(ChummerPresentationRoot)/Chummer.Presentation/Chummer.Presentation.csproj"
                      AdditionalProperties="RuntimeIdentifier=;RuntimeIdentifiers=;SelfContained=false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;RuntimeIdentifiers;SelfContained" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot/**" />
    <None Remove="wwwroot/**" />
  </ItemGroup>
</Project>
