<Project>
  <!--
    ILLink 10.0.11 maps partial trimming to Copy for non-trimmable assemblies.
    File.Copy preserves the public SDK runtime DLL's 0744 mode, even under
    umask 077. Stage its pinned bytes as a fresh private input before the
    official linker captures its items. Do not chmod SDK/cache/output trees or
    loosen the post-publish custody verifier.

    This internal extension is restricted to the governed Linux release lane
    and Android SDK 36.1.69. Preserve every ResolvedFileToPublish metadata field
    so downstream Android ProcessAssemblies sees the normal linked output.
  -->
  <Target Name="_ChummerStageAndroidSdk36169RuntimeInput"
          BeforeTargets="_ComputeManagedAssemblyToLink"
          Condition="'$(Configuration)' == 'Release' And '$(PublishTrimmed)' == 'true' And '$(AndroidNETSdkVersion)' == '36.1.69' And '$(ChummerReleaseIntermediateRoot)' != '' And $([MSBuild]::IsOSPlatform('Linux'))">
    <PropertyGroup>
      <_ChummerSdkRuntimeInputRoot>$([MSBuild]::EnsureTrailingSlash($([MSBuild]::NormalizePath('$(IntermediateOutputPath)'))))</_ChummerSdkRuntimeInputRoot>
      <_ChummerSdkRuntimeStagedPath>$(_ChummerSdkRuntimeInputRoot)chummer-android-sdk-36.1.69-runtime/Mono.Android.Runtime.dll</_ChummerSdkRuntimeStagedPath>
    </PropertyGroup>
    <ItemGroup>
      <_ChummerSdkRuntimeSource Remove="@(_ChummerSdkRuntimeSource)" />
      <_ChummerSdkRuntimeStaged Remove="@(_ChummerSdkRuntimeStaged)" />
      <_ChummerSdkRuntimeSource Include="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Mono.Android.Runtime.dll'">
        <ChummerOriginalSdkRuntimeIdentity>%(ResolvedFileToPublish.Identity)</ChummerOriginalSdkRuntimeIdentity>
        <ChummerStagedSdkRuntimeIdentity>$(_ChummerSdkRuntimeStagedPath)</ChummerStagedSdkRuntimeIdentity>
      </_ChummerSdkRuntimeSource>
    </ItemGroup>
    <Error Condition="'@(_ChummerSdkRuntimeSource->Count())' != '1'"
           Text="Governed Android SDK 36.1.69 staging requires exactly one Mono.Android.Runtime publish input." />
    <Error Condition="'%(_ChummerSdkRuntimeSource.PostprocessAssembly)' != 'true'"
           Text="Governed Android SDK 36.1.69 runtime input must participate in the official linker pipeline." />
    <Error Condition="$([System.String]::new('$(MSBuildThisFileDirectory)').Contains(';')) Or $([System.String]::new('%(_ChummerSdkRuntimeSource.Identity)').Contains(';')) Or $([System.String]::new('$(_ChummerSdkRuntimeInputRoot)').Contains(';'))"
           Text="Governed Android SDK staging paths must not contain MSBuild environment-list separators." />
    <!-- A constant shell command expands quoted environment variables only;
         source/workspace paths never become shell command text. -->
    <Exec Command="/usr/bin/python3 -I -E -S -B &quot;$CHUMMER_SDK_STAGING_SCRIPT&quot; --source &quot;$CHUMMER_SDK_STAGING_SOURCE&quot; --intermediate-root &quot;$CHUMMER_SDK_STAGING_ROOT&quot;"
          EnvironmentVariables="CHUMMER_SDK_STAGING_SCRIPT=$(MSBuildThisFileDirectory)../../scripts/stage_android_sdk_runtime.py;CHUMMER_SDK_STAGING_SOURCE=%(_ChummerSdkRuntimeSource.Identity);CHUMMER_SDK_STAGING_ROOT=$(_ChummerSdkRuntimeInputRoot)" />
    <Error Condition="!Exists('$(_ChummerSdkRuntimeStagedPath)')"
           Text="Governed Android SDK runtime staging produced no private input." />
    <ItemGroup>
      <_ChummerSdkRuntimeStaged Include="@(_ChummerSdkRuntimeSource->'%(ChummerStagedSdkRuntimeIdentity)')" />
      <ResolvedFileToPublish Remove="@(_ChummerSdkRuntimeSource)" />
      <ResolvedFileToPublish Include="@(_ChummerSdkRuntimeStaged)" />
      <FileWrites Include="@(_ChummerSdkRuntimeStaged)" />
    </ItemGroup>
    <PropertyGroup>
      <_ChummerSdkRuntimeInputStaged>true</_ChummerSdkRuntimeInputStaged>
    </PropertyGroup>
  </Target>

  <Target Name="_ChummerRequireStagedAndroidSdk36169RuntimeOutput"
          AfterTargets="ILLink"
          Condition="'$(_ChummerSdkRuntimeInputStaged)' == 'true'">
    <PropertyGroup>
      <_ChummerSdkRuntimeLinkedPath>$([MSBuild]::NormalizePath('$(IntermediateLinkDir)', 'Mono.Android.Runtime.dll'))</_ChummerSdkRuntimeLinkedPath>
    </PropertyGroup>
    <!-- This preserved framework assembly must survive. Do not allow a missing
         output to leave original identities in the SDK's removed/deps lists. -->
    <Error Condition="!Exists('$(IntermediateLinkDir)Mono.Android.Runtime.dll')"
           Text="Governed Android SDK runtime staging lost its required linked output." />
    <ItemGroup>
      <_ChummerSdkRuntimePublished Remove="@(_ChummerSdkRuntimePublished)" />
      <_ChummerSdkRuntimePublished Include="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Mono.Android.Runtime.dll'" />
    </ItemGroup>
    <Error Condition="'@(_ChummerSdkRuntimePublished->Count())' != '1'"
           Text="Governed Android SDK runtime staging requires one linked publish output." />
    <Error Condition="'%(_ChummerSdkRuntimePublished.FullPath)' != '$(_ChummerSdkRuntimeLinkedPath)'"
           Text="Governed Android SDK runtime publish identity did not converge on its linked output." />
  </Target>

  <!--
    Microsoft.Android.Sdk.Linux 36.1.69 leaves untrimmed satellite resource
    assemblies in ResolvedAssemblies with their immutable NuGet-cache identity.
    The official post-link AssemblyModifierPipeline writes .jlo.xml/.typemap.xml
    sidecars beside every resolved assembly, and later shrink-copy targets write
    there too, so an otherwise read-only restore cache is mutated.

    Stage only exact unprocessed satellite inputs into a build-owned directory
    before the SDK captures _AllResolvedAssemblies. All official Android targets
    and task arguments remain intact; their resolved, sidecar, shrink, AOT, and
    packaging paths now consistently refer to build-owned files.
  -->
  <Target Name="_ChummerStageAndroidSdk36169Satellites"
          BeforeTargets="_LinkAssembliesNoShrinkInputs"
          Condition="'$(Configuration)' == 'Release' And '$(PublishTrimmed)' == 'true'">
    <PropertyGroup>
      <_ChummerSatellitePipelineRoot>$([MSBuild]::EnsureTrailingSlash($([MSBuild]::NormalizePath('$(IntermediateOutputPath)', 'chummer-android-sdk-36.1.69-satellites'))))</_ChummerSatellitePipelineRoot>
    </PropertyGroup>

    <ItemGroup>
      <_ChummerSatelliteRegular Remove="@(_ChummerSatelliteRegular)" />
      <_ChummerSatelliteSource Remove="@(_ChummerSatelliteSource)" />
      <_ChummerSatelliteStaged Remove="@(_ChummerSatelliteStaged)" />
      <_ChummerSatelliteUserSource Remove="@(_ChummerSatelliteUserSource)" />
      <_ChummerSatelliteFrameworkSource Remove="@(_ChummerSatelliteFrameworkSource)" />
      <_ChummerSatelliteMembership Remove="@(_ChummerSatelliteMembership)" />
      <_ChummerSatelliteMembershipMismatch Remove="@(_ChummerSatelliteMembershipMismatch)" />
      <_ChummerSatelliteSymbolSource Remove="@(_ChummerSatelliteSymbolSource)" />
      <_ChummerSatelliteShrunkSource Remove="@(_ChummerSatelliteShrunkSource)" />
      <_ChummerSatelliteStagedShrunk Remove="@(_ChummerSatelliteStagedShrunk)" />
      <_ChummerSatelliteUnsupported Remove="@(_ChummerSatelliteUnsupported)" />
      <_ChummerSatelliteUnexpectedPostprocessed Remove="@(_ChummerSatelliteUnexpectedPostprocessed)" />
      <_ChummerSatelliteUnsafe Remove="@(_ChummerSatelliteUnsafe)" />
      <_ChummerSatelliteMissingAfterCopy Remove="@(_ChummerSatelliteMissingAfterCopy)" />

      <_ChummerSatelliteRegular
          Include="@(ResolvedAssemblies->WithMetadataValue('PostprocessAssembly', 'true'))" />
      <_ChummerSatelliteSource
          Include="@(ResolvedAssemblies)"
          Exclude="@(_ChummerSatelliteRegular)"
          Condition="'%(ResolvedAssemblies.Extension)' == '.dll' And $([System.String]::new('%(ResolvedAssemblies.Filename)').EndsWith('.resources', System.StringComparison.Ordinal)) And '%(ResolvedAssemblies.AssetType)' == 'resources' And '%(ResolvedAssemblies.DestinationSubPath)' != '' And '%(ResolvedAssemblies.DestinationSubPath)' != '%(ResolvedAssemblies.Filename)%(ResolvedAssemblies.Extension)'">
        <ChummerOriginalIdentity>%(ResolvedAssemblies.Identity)</ChummerOriginalIdentity>
        <ChummerStagedIdentity>$([MSBuild]::NormalizePath('$(_ChummerSatellitePipelineRoot)', '%(ResolvedAssemblies.DestinationSubPath)'))</ChummerStagedIdentity>
      </_ChummerSatelliteSource>
      <_ChummerSatelliteStaged Include="@(_ChummerSatelliteSource->'%(ChummerStagedIdentity)')" />
      <_ChummerSatelliteUnsupported
          Include="@(ResolvedAssemblies)"
          Exclude="@(_ChummerSatelliteRegular);@(_ChummerSatelliteSource)" />
      <_ChummerSatelliteUnexpectedPostprocessed
          Include="@(_ChummerSatelliteRegular)"
          Condition="'%(_ChummerSatelliteRegular.Extension)' == '.dll' And $([System.String]::new('%(_ChummerSatelliteRegular.Filename)').EndsWith('.resources', System.StringComparison.Ordinal))" />
      <_ChummerSatelliteUnsafe
          Include="@(_ChummerSatelliteSource)"
          Condition="!$([System.String]::new('%(_ChummerSatelliteSource.ChummerStagedIdentity)').StartsWith('$(_ChummerSatellitePipelineRoot)', System.StringComparison.Ordinal)) Or $([System.String]::new('%(_ChummerSatelliteSource.DestinationSubPath)').Contains('\'))" />

      <_ChummerSatelliteUserSource
          Include="@(ResolvedUserAssemblies)"
          Condition="'%(ResolvedUserAssemblies.Extension)' == '.dll' And $([System.String]::new('%(ResolvedUserAssemblies.Filename)').EndsWith('.resources', System.StringComparison.Ordinal)) And '%(ResolvedUserAssemblies.AssetType)' == 'resources' And '%(ResolvedUserAssemblies.DestinationSubPath)' != '' And '%(ResolvedUserAssemblies.DestinationSubPath)' != '%(ResolvedUserAssemblies.Filename)%(ResolvedUserAssemblies.Extension)'" />
      <_ChummerSatelliteFrameworkSource
          Include="@(ResolvedFrameworkAssemblies)"
          Condition="'%(ResolvedFrameworkAssemblies.Extension)' == '.dll' And $([System.String]::new('%(ResolvedFrameworkAssemblies.Filename)').EndsWith('.resources', System.StringComparison.Ordinal)) And '%(ResolvedFrameworkAssemblies.AssetType)' == 'resources' And '%(ResolvedFrameworkAssemblies.DestinationSubPath)' != '' And '%(ResolvedFrameworkAssemblies.DestinationSubPath)' != '%(ResolvedFrameworkAssemblies.Filename)%(ResolvedFrameworkAssemblies.Extension)'" />
      <_ChummerSatelliteMembership Include="@(_ChummerSatelliteUserSource);@(_ChummerSatelliteFrameworkSource)" />
      <_ChummerSatelliteMembershipMismatch
          Include="@(_ChummerSatelliteSource)"
          Exclude="@(_ChummerSatelliteMembership)" />
      <_ChummerSatelliteMembershipMismatch
          Include="@(_ChummerSatelliteMembership)"
          Exclude="@(_ChummerSatelliteSource)" />
      <_ChummerSatelliteSymbolSource
          Include="@(ResolvedSymbols)"
          Condition="'%(ResolvedSymbols.Extension)' == '.pdb' And $([System.String]::new('%(ResolvedSymbols.Filename)').EndsWith('.resources', System.StringComparison.Ordinal))" />
      <_ChummerSatelliteShrunkSource
          Include="@(_ShrunkAssemblies)"
          Condition="'%(_ShrunkAssemblies.Extension)' == '.dll' And $([System.String]::new('%(_ShrunkAssemblies.Filename)').EndsWith('.resources', System.StringComparison.Ordinal)) And '%(_ShrunkAssemblies.AssetType)' == 'resources' And '%(_ShrunkAssemblies.DestinationSubPath)' != '' And '%(_ShrunkAssemblies.DestinationSubPath)' != '%(_ShrunkAssemblies.Filename)%(_ShrunkAssemblies.Extension)'" />
      <_ChummerSatelliteStagedShrunk Include="@(_ChummerSatelliteStaged->'%(RootDir)%(Directory)shrunk/%(Filename)%(Extension)')" />
    </ItemGroup>

    <Error
        Condition="'@(_ChummerSatelliteUnsupported)' != ''"
        Text="Microsoft.Android.Sdk.Linux 36.1.69 workaround found unsupported unprocessed assemblies: @(_ChummerSatelliteUnsupported, ', ')" />
    <Error
        Condition="'@(_ChummerSatelliteUnexpectedPostprocessed)' != ''"
        Text="Microsoft.Android.Sdk.Linux 36.1.69 marked satellite resource assemblies for post-processing: @(_ChummerSatelliteUnexpectedPostprocessed, ', ')" />
    <Error
        Condition="'@(_ChummerSatelliteUnsafe)' != ''"
        Text="Microsoft.Android.Sdk.Linux 36.1.69 workaround refused an unsafe satellite staging path: @(_ChummerSatelliteUnsafe, ', ')" />
    <Error
        Condition="'@(_ChummerSatelliteStaged->Count())' != '@(_ChummerSatelliteStaged->Distinct()->Count())'"
        Text="Microsoft.Android.Sdk.Linux 36.1.69 workaround found colliding satellite staging paths." />
    <Error
        Condition="'@(_ChummerSatelliteMembershipMismatch)' != '' Or '@(_ChummerSatelliteSource->Count())' != '@(_ChummerSatelliteMembership->Count())'"
        Text="Microsoft.Android.Sdk.Linux 36.1.69 workaround could not map every satellite to exactly one user/framework list." />
    <Error
        Condition="'@(_ChummerSatelliteSource->Count())' != '@(_ChummerSatelliteShrunkSource->Count())'"
        Text="Microsoft.Android.Sdk.Linux 36.1.69 workaround could not map every satellite shrunk-assembly destination." />
    <Error
        Condition="'@(_ChummerSatelliteSource)' != '' And ('$(AndroidIncludeDebugSymbols)' == 'true' Or '@(_ChummerSatelliteSymbolSource)' != '')"
        Text="Microsoft.Android.Sdk.Linux 36.1.69 satellite staging is bound to the Release symbols-disabled pipeline." />

    <MakeDir Directories="@(_ChummerSatelliteStaged->'%(RootDir)%(Directory)')" />
    <CopyIfChanged SourceFiles="@(_ChummerSatelliteSource)"
                   DestinationFiles="@(_ChummerSatelliteStaged)" />

    <ItemGroup>
      <_ChummerSatelliteMissingAfterCopy
          Include="@(_ChummerSatelliteStaged)"
          Condition="!Exists('%(_ChummerSatelliteStaged.Identity)')" />
    </ItemGroup>
    <Error
        Condition="'@(_ChummerSatelliteMissingAfterCopy)' != ''"
        Text="Microsoft.Android.Sdk.Linux 36.1.69 workaround failed to stage satellite inputs: @(_ChummerSatelliteMissingAfterCopy, ', ')" />

    <ItemGroup>
      <ResolvedAssemblies Remove="@(_ChummerSatelliteSource)" />
      <ResolvedAssemblies Include="@(_ChummerSatelliteStaged)" />
      <ResolvedUserAssemblies Remove="@(_ChummerSatelliteUserSource)" />
      <ResolvedUserAssemblies Include="@(_ChummerSatelliteStaged)"
                              Condition="'%(FrameworkAssembly)' != 'true'" />
      <ResolvedFrameworkAssemblies Remove="@(_ChummerSatelliteFrameworkSource)" />
      <ResolvedFrameworkAssemblies Include="@(_ChummerSatelliteStaged)"
                                   Condition="'%(FrameworkAssembly)' == 'true'" />
      <_ShrunkAssemblies Remove="@(_ChummerSatelliteShrunkSource)" />
      <_ShrunkAssemblies Include="@(_ChummerSatelliteStagedShrunk)" />

      <FileWrites Include="@(_ChummerSatelliteStaged)" />
      <FileWrites Include="@(_ChummerSatelliteStaged->'%(RootDir)%(Directory)%(Filename).jlo.xml')" />
      <FileWrites Include="@(_ChummerSatelliteStaged->'%(RootDir)%(Directory)%(Filename).typemap.xml')" />
      <FileWrites Include="@(_ChummerSatelliteStagedShrunk)" />
    </ItemGroup>

    <Hash ItemsToHash="@(ResolvedAssemblies)">
      <Output TaskParameter="HashResult" PropertyName="_ResolvedUserAssembliesHash" />
    </Hash>
    <WriteLinesToFile File="$(_ResolvedUserAssembliesHashFile)"
                      Lines="$(_ResolvedUserAssembliesHash)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <Delete Files="$(_AdditionalPostLinkerStepsFlag)"
            Condition="'@(_ChummerSatelliteSource)' != ''" />
  </Target>
</Project>
