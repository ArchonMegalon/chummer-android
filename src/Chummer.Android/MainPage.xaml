<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Chummer.Android.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Chummer.Android.Components"
    BackgroundColor="#102426">
    <BlazorWebView x:Name="ChummerWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type local:AndroidAppHost}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>
</ContentPage>
