<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Chummer.Android</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiVersion>10.0.20</MauiVersion>
    <ApplicationTitle>Chummer</ApplicationTitle>
    <ApplicationId>com.myexternalbrain.chummer</ApplicationId>
    <ApplicationDisplayVersion>0.1.0-preview.11</ApplicationDisplayVersion>
    <ApplicationVersion>11</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <TargetSdkVersion>36</TargetSdkVersion>
    <AndroidMinSdkVersion>24</AndroidMinSdkVersion>
    <AndroidPackageFormats Condition="'$(Configuration)' == 'Debug'">apk</AndroidPackageFormats>
    <AndroidPackageFormats Condition="'$(Configuration)' == 'Release'">aab</AndroidPackageFormats>
    <EmbedAssembliesIntoApk Condition="'$(Configuration)' == 'Debug'">true</EmbedAssembliesIntoApk>
    <AndroidUseAapt2>true</AndroidUseAapt2>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <ChummerAndroidRuntimeIdentifier Condition="'$(ChummerAndroidRuntimeIdentifier)' == ''">android-arm64</ChummerAndroidRuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(ChummerAndroidRuntimeIdentifier)</RuntimeIdentifier>
    <_GlobalPropertiesToRemoveFromProjectReferences>$(_GlobalPropertiesToRemoveFromProjectReferences);RuntimeIdentifier;RuntimeIdentifiers;SelfContained</_GlobalPropertiesToRemoveFromProjectReferences>
    <AndroidLinkMode Condition="'$(Configuration)' == 'Release'">SdkOnly</AndroidLinkMode>
    <AndroidEnableProfiledAot Condition="'$(Configuration)' == 'Release'">true</AndroidEnableProfiledAot>
    <AndroidKeyStore Condition="'$(AndroidSigningKeyStore)' != ''">true</AndroidKeyStore>
    <ChummerPresentationRoot Condition="'$(ChummerPresentationRoot)' == ''">../../../chummer-presentation</ChummerPresentationRoot>
    <ChummerCoreEngineRoot Condition="'$(ChummerCoreEngineRoot)' == ''">$(ChummerPresentationRoot)/../chummer-core-engine</ChummerCoreEngineRoot>
    <ChummerPlayReviewEnabled Condition="'$(ChummerPlayReviewEnabled)' == ''">true</ChummerPlayReviewEnabled>
    <DefineConstants Condition="'$(ChummerPlayReviewEnabled)' == 'true'">$(DefineConstants);CHUMMER_PLAY_REVIEW_ENABLED</DefineConstants>
    <ChummerApi36ProofInstrumentation Condition="'$(ChummerApi36ProofInstrumentation)' == ''">false</ChummerApi36ProofInstrumentation>
    <DefineConstants Condition="'$(ChummerApi36ProofInstrumentation)' == 'true'">$(DefineConstants);CHUMMER_API36_PROOF_INSTRUMENTATION</DefineConstants>
  </PropertyGroup>

  <Target Name="ValidateApi36ProofInstrumentationBuild"
          BeforeTargets="PrepareForBuild"
          Condition="'$(ChummerApi36ProofInstrumentation)' == 'true'">
    <Error Condition="'$(Configuration)' != 'Debug'"
           Text="API-36 proof instrumentation is allowed only in the dedicated Debug APK." />
    <Error Condition="'$(AndroidPackageFormats)' != 'apk'"
           Text="API-36 proof instrumentation requires exact APK packaging." />
    <Error Condition="'$(RuntimeIdentifier)' != 'android-x64' Or '$(ChummerAndroidRuntimeIdentifier)' != 'android-x64'"
           Text="API-36 proof instrumentation is restricted to the hosted x86_64 APK." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ChummerApi36ProofSourceCommit)', '^[0-9a-f]{40}$'))"
           Text="API-36 proof instrumentation requires one lowercase source commit." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ChummerApi36ProofSourceTree)', '^[0-9a-f]{40}$'))"
           Text="API-36 proof instrumentation requires one lowercase source tree." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ChummerApi36ProofGateContractSha256)', '^[0-9a-f]{64}$'))"
           Text="API-36 proof instrumentation requires the exact gate-contract SHA-256." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ChummerApi36ProofBuildId)', '^[A-Za-z0-9._-]{1,128}$'))"
           Text="API-36 proof instrumentation requires one bounded build identity." />
  </Target>

  <PropertyGroup Condition="'$(AndroidSigningKeyStore)' != ''">
    <AndroidSigningStorePass>$(ChummerAndroidSigningStorePass)</AndroidSigningStorePass>
    <AndroidSigningKeyAlias>$(ChummerAndroidSigningKeyAlias)</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>$(ChummerAndroidSigningKeyPass)</AndroidSigningKeyPass>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Proof/Api36ProofState.cs;Proof/Api36ProofStatePublisher.cs" />
    <Compile Include="Proof/Api36ProofState.cs;Proof/Api36ProofStatePublisher.cs"
             Condition="'$(ChummerApi36ProofInstrumentation)' == 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(ChummerApi36ProofInstrumentation)' == 'true'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ChummerApi36ProofSourceCommit</_Parameter1>
      <_Parameter2>$(ChummerApi36ProofSourceCommit)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ChummerApi36ProofSourceTree</_Parameter1>
      <_Parameter2>$(ChummerApi36ProofSourceTree)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ChummerApi36ProofGateContractSha256</_Parameter1>
      <_Parameter2>$(ChummerApi36ProofGateContractSha256)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ChummerApi36ProofBuildId</_Parameter1>
      <_Parameter2>$(ChummerApi36ProofBuildId)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ChummerApi36ProofRuntimeIdentifier</_Parameter1>
      <_Parameter2>$(RuntimeIdentifier)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appiconfg.svg" Color="#102426" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#102426" BaseSize="512,512" />
    <MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="$(ChummerCoreEngineRoot)/Chummer/data/**"
                  LogicalName="chummer-content/data/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="$(ChummerCoreEngineRoot)/Chummer/lang/**"
                  LogicalName="chummer-content/lang/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="Content/chummer-content-manifest.json"
                  LogicalName="chummer-content/manifest.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="Xamarin.Google.Android.Play.App.Update" Version="2.1.0.19" />
    <!-- Microsoft .NET binding for Google's com.google.android.play:review:2.0.2 artifact. -->
    <PackageReference Include="Xamarin.Google.Android.Play.Review" Version="2.0.2.9" />
    <PackageReference Include="Xamarin.AndroidX.Activity.Ktx" Version="1.13.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.8.9.4" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.5.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(ChummerPresentationRoot)/Chummer.Desktop.Runtime/Chummer.Desktop.Runtime.csproj"
                      AdditionalProperties="RuntimeIdentifier=;RuntimeIdentifiers=;SelfContained=false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;RuntimeIdentifiers;SelfContained" />
    <ProjectReference Include="$(ChummerPresentationRoot)/Chummer.Presentation/Chummer.Presentation.csproj"
                      AdditionalProperties="RuntimeIdentifier=;RuntimeIdentifiers=;SelfContained=false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;RuntimeIdentifiers;SelfContained" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot/**" />
    <None Remove="wwwroot/**" />
  </ItemGroup>
</Project>
